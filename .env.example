# Copy this file to .env for local runs. .env is ignored by Git; never commit real keys.
# KEY.md describes every variable: what it is for, how to get it, and its limits.
# A key is required only while a source that uses it is enabled in sources.json; a missing
# key for an enabled source stops the run with a configuration error.

# abuse.ch Auth-Key from https://auth.abuse.ch/. Used by the threatfox feed and the urlhaus
# enricher.
ABUSECH_API_KEY=replace-me

# IPinfo access token from https://ipinfo.io/account/token (free IPinfo Lite plan). Used by
# the ipinfo enricher.
IPINFO_TOKEN=replace-me

# VirusTotal API key from https://www.virustotal.com/gui/my-apikey. Used by the virustotal
# enricher.
VIRUSTOTAL_API_KEY=replace-me

# AbuseIPDB APIv2 key from your AbuseIPDB account's API page. Used by the abuseipdb enricher.
ABUSEIPDB_API_KEY=replace-me

# AlienVault OTX (LevelBlue) key from https://otx.alienvault.com/settings. Used by the otx
# enricher.
OTX_API_KEY=replace-me

# Shodan API key from https://account.shodan.io/. Used by the shodan enricher. The keyless
# internetdb enricher doesn't need it.
SHODAN_API_KEY=replace-me
